{
  "name": "@bananapus/nana-sdk-connect",
  "version": "0.5.6",
  "description": "Sign in to a Juicebox app with a passkey account from Juicebox Center or an external wallet",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bananapus/juice-sdk-v4",
    "directory": "packages/connect"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate-types": "tsc --emitDeclarationOnly",
    "prebuild": "rm -Rf dist",
    "build": "tsup && npm run generate-types",
    "type-check": "tsc --noEmit && tsc --project ./tsconfig.test.json"
  },
  "license": "ISC",
  "sideEffects": false,
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "viem": "^2.37.5",
    "wagmi": "^2.10.2 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "wagmi": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^3.2.6",
    "jsdom": "^26.1.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.5.1",
    "viem": "^2.37.5",
    "vitest": "^3.2.6",
    "wagmi": "^2.10.2"
  },
  "files": [
    "dist/**/*"
  ],
  "exports": {
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./wagmi": {
      "types": "./dist/wagmi/index.d.ts",
      "import": "./dist/wagmi/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@me.jango/center-wallet": "^0.3.0"
  }
}
