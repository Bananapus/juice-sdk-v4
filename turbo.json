{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["PROTOCOL_DEPLOYMENTS_DIR"],
  "tasks": {
    "build": {
      "cache": false,
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"],
      "outputs": ["dist/**"]
    },
    "test": {},
    "test:coverage": {
      "outputs": ["coverage/**"]
    },
    "type-check": {
      "dependsOn": ["build"]
    }
  }
}
